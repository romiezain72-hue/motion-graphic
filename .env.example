# ============================================================================
# 1. VOICE OVER (TTS) PROVIDER CONFIGURATION (Pilih salah satu: elevenlabs | gemini | edge-tts)
# ============================================================================
# Opsi A (Paling Natural & Ekspresif): "elevenlabs" (Wajib isi ELEVENLABS_API_KEY)
# Opsi B (Memanfaatkan Akun Gemini / Google AI Studio): "gemini" (Wajib isi GEMINI_API_KEY)
# Opsi C (100% Gratis Tanpa API Key): "edge-tts" (id-ID-ArdiNeural atau id-ID-GadisNeural)
TTS_PROVIDER=edge-tts

# --- Konfigurasi ElevenLabs Pro (Otomatis aktif begitu ELEVENLABS_API_KEY diisi!) ---
ELEVENLABS_API_KEY=
# Voice ID Default: "pNInz6obpgDQGcFmaJgB" (Adam Deep Documentary) atau "EXAVITQu4vr4xnSDxMaL" (Bella Editorial)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Konfigurasi Gemini 2.5 Native Audio TTS (Otomatis aktif jika TTS_PROVIDER=gemini) ---
GEMINI_API_KEY=
# Pilihan suara Gemini TTS: Kore | Puck | Charon | Fenrir | Aoede
GEMINI_TTS_VOICE=Charon

# --- Konfigurasi Edge-TTS (Fallback Gratis + FFmpeg Broadcast EQ) ---
# Pilihan suara Bahasa Indonesia: id-ID-ArdiNeural (Pria) | id-ID-GadisNeural (Wanita)
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=+6%
TTS_PITCH=-2Hz

# ============================================================================
# 2. GITHUB ACTIONS CLOUD RENDERING (Lempar Render Berat ke Cloud GitHub)
# ============================================================================
# Format: username/nama-repo (contoh: johndoe/motion-graphic)
GITHUB_REPO=
# Personal Access Token GitHub (Classic/Fine-grained dengan izin `repo` & `workflow`)
GITHUB_TOKEN=
GITHUB_BRANCH=main
